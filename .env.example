# Valores locais para demonstração. Copie como .env; nunca publique o .env real.
MOODLE_URL=http://moodle-demo:8080
MOODLE_TOKEN=token-demonstracao
MOODLE_COURSE_ID=42
POLL_INTERVAL_SECONDS=3600
AMQP_URL=amqp://reengaja:demo-local@rabbitmq:5672/%2F
RABBITMQ_PASSWORD=demo-local
QUEUE_PREFIX=reengajamento
RETRY_DELAY_MS=60000
MAX_ATTEMPTS=3
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Reengaja Moodle <lembretes@example.test>
DISPLAY_TIMEZONE=America/Sao_Paulo
